from pydantic import BaseModel


class UserRequest(BaseModel):
    name: str
    age: int


class User(BaseModel):
    id: int
    name: str
    age: int

# app/services/user_service.py

from app.models import User

fake_db = []


def list_users():
    return fake_db


def create_user(name: str, age: int):
    user = User(id=len(fake_db) + 1, name=name, age=age)
    fake_db.append(user)
    return user

# app/routers/user.py

from fastapi import APIRouter
from app.models import UserRequest, User
from app.services.user_service import list_users, create_user

router = APIRouter()


@router.get("/users", response_model=list[User])
def get_users():
    return list_users()


@router.post("/users", response_model=User)
def create_user_api(req: UserRequest):
    return create_user(req.name, req.age)

# app/main.py

from fastapi import FastAPI
import yaml

from app.routers import user

# 读取 openapi.yaml
with open("openapi.yaml") as f:
    openapi_schema = yaml.safe_load(f)

app = FastAPI()


# 覆盖 OpenAPI
def custom_openapi():
    return openapi_schema


app.openapi = custom_openapi

# 注册路由
app.include_router(user.router)


@app.get("/health")
def health():
    return {"status": "ok"}

