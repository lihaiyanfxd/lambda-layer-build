def loadJsonRules():
    # =========================
    # 1. 基础信息（固定）
    # =========================
    contract_basic = {
        "pol": "POL10001",
        "status": "ACTIVE"
    }

    contractor = {
        "name": "山田太郎",
        "contact": {
            "phone": "09011112222",
            "email": "taro@example.com"
        },
        "address": {
            "city": "Tokyo",
            "zip": "1600000"
        }
    }

    # =========================
    # 2. 生成 oya productList
    # =========================
    oya_products = []

    for i in range(1, 1001):
        product = {
            "productId": f"LIFE{i:02d}",   # LIFE01～LIFE1000（两位起步）
            "productName": f"終身保険{i}",
            "coverage": {
                "amount": 10000000 + i * 1000
            },
            "benefitList": [
                {
                    "benefitId": f"ACC{i}",
                    "benefitName": f"傷害特約{i}",
                    "benefitAmount": 1000000 + i * 1000
                }
            ],
            "premium": {
                "monthly": 10000 + i
            }
        }
        oya_products.append(product)

    oya_json = {
        "contract": {
            "contractBasic": contract_basic,
            "contractor": contractor,
            "productList": oya_products
        }
    }

    # =========================
    # 3. 生成 ko（基于oya变更）
    # =========================
    ko_products = []

    for prod in oya_products:
        i = int(prod["productId"].replace("LIFE", ""))

        new_product = {
            "productId": prod["productId"],
            "productName": prod["productName"],

            # ⭐ 子：coverage变化
            "coverage": {
                "amount": prod["coverage"]["amount"] + 10000000
            },

            # ⭐ 子：benefit变化
            "benefitList": [
                {
                    "benefitId": prod["benefitList"][0]["benefitId"],
                    "benefitName": prod["benefitList"][0]["benefitName"],
                    "benefitAmount": prod["benefitList"][0]["benefitAmount"] + 1000000
                }
            ],

            # ⭐ 子：premium变化
            "premium": {
                "monthly": prod["premium"]["monthly"] + 10000
            }
        }

        ko_products.append(new_product)

    ko_json = {
        "contract": {
            "contractBasic": contract_basic,
            "contractor": contractor,
            "productList": ko_products
        }
    }

    v1(oya_json,ko_json)

def v1(oya_json,ko_json):
    oya_products = oya_json["contract"]["productList"]
    ko_products = ko_json["contract"]["productList"]

    # =========================
    # 2. 二重ループ
    # =========================
    start = time.perf_counter()

    result_double = []

    for oya_prod in oya_products:
        merged = oya_prod.copy()

        for ko_prod in ko_products:
            if ko_prod["productId"] == oya_prod["productId"]:
                merged = ko_prod
                break

        result_double.append(merged)

    time_double = time.perf_counter() - start
    print(time_double)

    # =========================
    # 3. dict方式
    # =========================
    start = time.perf_counter()

    ko_dict = {k["productId"]: k for k in ko_products}

    result_dict = []

    for oya_prod in oya_products:
        pid = oya_prod["productId"]

        if pid in ko_dict:
            result_dict.append(ko_dict[pid])
        else:
            result_dict.append(oya_prod)

    time_dict = time.perf_counter() - start
    print(time_dict)
    return result_dict
