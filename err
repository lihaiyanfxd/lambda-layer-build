import json
import orjson
import ujson
import time

from setJson import setData


# =========================
# deep merge（按指定key）
# =========================
def deep_merge_by_key(oya, ko, key="productId"):

    result = oya

    oya_list = result["contract"]["productList"]
    ko_list = ko["contract"]["productList"]

    for o in oya_list:
        for k in ko_list:
            if o[key] == k[key]:
                # 覆盖字段（子优先）
                for field in k:
                    if field != key:
                        if isinstance(k[field], dict):
                            o[field].update(k[field])
                        else:
                            o[field] = k[field]

    return result


# =========================
# json
# =========================
def merge_json(oya, ko):
    o = json.loads(json.dumps(oya))
    return deep_merge_by_key(o, ko)


# =========================
# orjson
# =========================
def merge_orjson(oya, ko):
    o = orjson.loads(orjson.dumps(oya))
    return deep_merge_by_key(o, ko)


# =========================
# ujson
# =========================
def merge_ujson(oya, ko):
    o = ujson.loads(ujson.dumps(oya))
    return deep_merge_by_key(o, ko)


# =========================
# benchmark
# =========================
def benchmark(func, oya, ko, loop=100):
    start = time.perf_counter()

    for _ in range(loop):
        func(oya, ko)

    end = time.perf_counter()
    return end - start


# =========================
# run
# =========================
def run_test():
    oya, ko = setData()

    print("json   :", benchmark(merge_json, oya, ko))
    print("orjson :", benchmark(merge_orjson, oya, ko))
    print("ujson  :", benchmark(merge_ujson, oya, ko))


if __name__ == "__main__":
    run_test()
