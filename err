[tool.ruff.lint]
select = ["E", "F", "I"]
ignore = []
line-length = 88
{
  // 开启 Ruff
  "ruff.enable": true,

  // ❗关闭保存时自动格式化
  "editor.formatOnSave": false,

  // ❗禁止保存时自动修复（最关键）
  "editor.codeActionsOnSave": {
    "source.fixAll": false,
    "source.fixAll.ruff": false
  },

  // 不使用 Ruff 作为 formatter
  "editor.defaultFormatter": null,

  // 关闭 Ruff format（如果插件支持）
  "ruff.format.enable": false
}
