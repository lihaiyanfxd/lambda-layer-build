def merge_core(oya,ko):
    key = "productId"

    oya_list = oya["contract"]["productList"]
    ko_list = ko["contract"]["productList"]

    # dict
    ko_map = {k[key]: k for k in ko_list}

    for o in oya_list:
        pid = o[key]

        if pid in ko_map:
            k = ko_map[pid]

            for field in k:
                if field != key:
                    if isinstance(k[field], dict):
                        o[field].update(k[field])
                    else:
                        o[field] = k[field]

    return oya

