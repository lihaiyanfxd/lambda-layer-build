
import logging
from datetime import datetime

class CustomFormatter(logging.Formatter):

    def format(self, record):
        now = datetime.now().strftime("%Y/%m/%d %H:%M:%S.%f")[:-3]

        log = (
            f"日時：{now}\n"
            f"エラ区分：<{record.levelname}>\n"
            f"処理名：{record.funcName}\n"
            f"出力内容：{getattr(record, 'outputk', '')}\n"
            f"メッセージ：{record.getMessage()}"
        )

        return log

import logging
from app.core.config import settings
from app.core.log_formatter import CustomFormatter
def setup_logging():

    log_level = getattr(logging,settings.LOG_LEVEL)
    root_logger = logging.getLogger()
    root_logger.setLevel(log_level)

    #formatter = logging.Formatter(
    #    "%(levelname)s [%(name)s] %(message)s"
    #
    

    for handler in root_logger.handlers:
        handler.setFormatter(CustomFormatter())

    if not root_logger.handlers:
        handler = logging.StreamHandler()
        handler.setFormatter(CustomFormatter())
        root_logger.addHandler(handler)
    # 关闭 Mangum 日志
    logging.getLogger("mangum").setLevel(logging.CRITICAL)
