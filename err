import json


def merge_data(oya_items, ko_items):

    # 用 pol 建立索引
    oya_map = {item["pol"]: item for item in oya_items}

    result = []

    for ko in ko_items:

        pol = ko["pol"]

        if pol in oya_map:
            oya = oya_map[pol]

            merged = {
                "pol": pol,
                "edaban": ko["edaban"],
                "kihon": oya["kihon"],   # 来自 oya
                "address": ko["address"] # 来自 ko
            }

            result.append(merged)

    return result
