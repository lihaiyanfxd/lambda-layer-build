[tool.ruff.lint]
select = ["E", "F", "I"]
ignore = []

[MESSAGES CONTROL]
disable=
    C0114,
    C0115,
    C0116,
    C0410,   # import（交给 Ruff）
    C0411,   # import 排序（交给 Ruff）
    C0413,   # import 位置（交给 Ruff）
    C0330,   # 格式（交给 Ruff）

[FORMAT]
max-line-length=88

[DESIGN]
max-args=5

{
  "ruff.enable": true,
  "python.linting.pylintEnabled": true,

  // 不自动修复（避免冲突）
  "editor.formatOnSave": false,

  // 不让 Ruff 自动 fix
  "editor.codeActionsOnSave": {
    "source.fixAll.ruff": false
  }
}
