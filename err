def merge_simple(oya_items, ko_items):

    result = []

    for oya in oya_items:

        for ko in ko_items:

            if oya["pol"] == ko["pol"]:

                merged = {
                    "pol": oya["pol"],
                    "Kihondata": oya["Kihondata"],
                    "info": {
                        "test1": oya["info"]["test1"],
                        "test2": ko["info"]["test2"]
                    }
                }

                result.append(merged)

    return result
