from aws_lambda_powertools.event_handler.api_gateway import Router
from app.log.logger import logger
from aws_lambda_powertools.utilities.validation import validator

router = Router()
schema = {
    "type":"object",
    "properties":{
        "id":{
            "type":"integer"
        },
        "age":{
            "type":"integer"
        }
    },
    "required":["id"]
}
@router.post("/ping3")
@validator(inbound_schema=schema)
def ping3(event):
    return {"message": "user!"}

@router.get("/ping")
def ping():
    logger.info("ping called")
    return {"message": "pong11!"}

@router.get("/ping2")
def ping2():
    logger.info("ping2 called")
    return {"message": "pong222!"}

from aws_lambda_powertools.event_handler.api_gateway import (
    APIGatewayRestResolver,
    Response,
    content_types,
)
from app.services.ping_router import router as ping_router
from app.services.user_router import router as user_router
from app.log.logger import logger

app = APIGatewayRestResolver()

app.include_router(ping_router)
app.include_router(user_router)

@app.exception_handler(ValueError)
def handle_invalid_limit_qs(ex: ValueError):
    metadata = {"path": app.current_event.path, "query_strings": app.current_event.query_string_parameters}
    logger.error(f"Malformed request: {ex}", extra=metadata)

    return Response(
        status_code=400,
        content_type=content_types.TEXT_PLAIN,
        body="Invalid request parameters.",
    )

@logger.inject_lambda_context
def lambda_handler(event,context):
    return app.resolve(event,context)

