import json
import orjson
import ujson
import time
import copy

from setJson import setData
from mergeService import merge_double,merge_dict,merge_dict2

def loadJsonV1():
    oya,ko = setData()
    start = time.perf_counter()
    resutlt = merge_copy(oya,ko)
    time_use = time.perf_counter() - start
    print(time_use)
    return resutlt

# =========================
# 模拟 merge（简单版）
# =========================
def merge_copy(oya, ko):
    result = copy.deepcopy(oya)
    result["contract"].update(ko["contract"])
    return result


# =========================
# JSON 标准库
# =========================
def merge_json(oya, ko):
    o = json.loads(json.dumps(oya))
    o["contract"].update(ko["contract"])
    return o


# =========================
# orjson（最快🔥）
# =========================
def merge_orjson(oya, ko):
    o = orjson.loads(orjson.dumps(oya))
    o["contract"].update(ko["contract"])
    return o


# =========================
# ujson
# =========================
def merge_ujson(oya, ko):
    o = ujson.loads(ujson.dumps(oya))
    o["contract"].update(ko["contract"])
    return o
