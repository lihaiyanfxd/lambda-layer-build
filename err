def merge_manual(oya, ko):

    if oya["pol"] != ko["pol"]:
        return None

    result = {
        "pol": oya["pol"],
        "kihon": oya["kihon"],
        "info": {
            "test1": oya["info"]["test1"],
            "test2": ko["info"]["test2"]
        }
    }

    return result


start = time.perf_counter()
for _ in range(100000):
    merge_manual(oya, ko)
end = time.perf_counter()

print("manual merge time:", end - start)
