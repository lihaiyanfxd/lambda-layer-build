def get_by_path(data, path):

    keys = path.split(".")
    for k in keys:
        data = data[k]
    return data


def merge_path_rule(oya, ko, rules):

    result = oya.copy()

    for path, rule in rules.items():

        if rule == "child":

            parent_node = get_by_path(result, path)
            child_node = get_by_path(ko, path)

            parent_node.update(child_node)

        if rule == "append":

            parent_node = get_by_path(result, path)
            child_node = get_by_path(ko, path)

            parent_node.extend(child_node)

    return result
