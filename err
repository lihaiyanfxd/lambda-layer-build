from pydantic import BaseModel, Field


class UserRequest(BaseModel):
    name: str = Field(..., example="Alice")
    age: int = Field(..., ge=0, example=20)


class UserResponse(BaseModel):
    id: int
    name: str
    age: int



from app.models import UserResponse

fake_db = []


def create_user(name: str, age: int) -> UserResponse:
    user = UserResponse(id=len(fake_db) + 1, name=name, age=age)
    fake_db.append(user)
    return user


def list_users():
    return fake_db

from fastapi import APIRouter
from app.models import UserRequest, UserResponse
from app.services.user_service import create_user, list_users

router = APIRouter(prefix="/users", tags=["Users"])


@router.post("/", response_model=UserResponse)
def create_user_api(req: UserRequest):
    return create_user(req.name, req.age)


@router.get("/", response_model=list[UserResponse])
def list_users_api():
    return list_users()


