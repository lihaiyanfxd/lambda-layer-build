import json
import time


def merge_contract(oya_path="oya.json", ko_path="ko.json"):
    # =========================
    # 1. 读取数据
    # =========================
    with open(oya_path, "r", encoding="utf-8") as f:
        oya_json = json.load(f)

    with open(ko_path, "r", encoding="utf-8") as f:
        ko_json = json.load(f)

    oya_products = oya_json["contract"]["productList"]
    ko_products = ko_json["contract"]["productList"]

    # =========================
    # 2. 二重ループ
    # =========================
    start = time.perf_counter()

    result_double = []

    for oya_prod in oya_products:
        merged = oya_prod.copy()

        for ko_prod in ko_products:
            if ko_prod["productId"] == oya_prod["productId"]:
                merged = ko_prod
                break

        result_double.append(merged)

    time_double = time.perf_counter() - start

    # =========================
    # 3. dict方式
    # =========================
    start = time.perf_counter()

    ko_dict = {k["productId"]: k for k in ko_products}

    result_dict = []

    for oya_prod in oya_products:
        pid = oya_prod["productId"]

        if pid in ko_dict:
            result_dict.append(ko_dict[pid])
        else:
            result_dict.append(oya_prod)

    time_dict = time.perf_counter() - start

    # =========================
    # 4. 组装最终contract
    # =========================
    final_contract = {
        "contract": {
            "contractBasic": oya_json["contract"]["contractBasic"],
            "contractor": oya_json["contract"]["contractor"],
            "productList": result_dict
        }
    }

    # =========================
    # 5. return结果（重点）
    # =========================
    return {
        "merged_result": final_contract,
        "performance": {
            "double_loop_time": time_double,
            "dict_time": time_dict,
            "product_count": len(result_dict)
        }
    }


# =========================
# 调用示例
# =========================
if __name__ == "__main__":
    result = merge_contract()

    print("性能对比:")
    print(result["performance"])

    # 如果想看结果的一部分（避免太大）
    print("示例前2条product:")
    print(result["merged_result"]["contract"]["productList"][:2])
