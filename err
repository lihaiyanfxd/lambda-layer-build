from aws_lambda_powertools.event_handler.api_gateway import Router, APIGatewayRestResolver
from aws_lambda_powertools.utilities.validation import validator

# 定义 router
router = Router()

schema = {
    "type": "object",
    "properties": {
        "id": {"type": "integer"},
        "age": {"type": "integer"}
    },
    "required": ["id"]
}

@router.post("/ping3")
@validator(inbound_schema=schema, envelope=None)  # 关键：envelope=None
def ping3():
    body = router.current_event.json_body
    return {"id": body["id"], "age": body.get("age")}

# 其他路由
@router.get("/user")
def user():
    return {"message": "user!"}

# Lambda app
app = APIGatewayRestResolver()
app.include_router(router)

def lambda_handler(event, context):
    return app.resolve(event, context)
