def get(data, path):
    for p in path.split("."):
        data = data[p]
    return data
 
 
def set(data, path, value):
    keys = path.split(".")
    for k in keys[:-1]:
        data = data.setdefault(k, {})
    data[keys[-1]] = value
 
def merge_rule(oya, ko, rules):
 
    result = {}
    for rule in rules:
 
        path = rule["path"]
 
        if rule["rule"] == "parent":
            value = get(oya, path)
        else:
            value = get(ko, path)
 
        set(result, path, value)
 
    return result
