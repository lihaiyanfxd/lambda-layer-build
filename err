import json
import time

# =========================
# 1. 读取数据
# =========================
with open("oya.json", "r", encoding="utf-8") as f:
    oya_json = json.load(f)

with open("ko.json", "r", encoding="utf-8") as f:
    ko_json = json.load(f)

oya_products = oya_json["contract"]["productList"]
ko_products = ko_json["contract"]["productList"]

# =========================
# 2. 二重ループ merge
# =========================
start = time.perf_counter()

result_double = []

for oya_prod in oya_products:
    merged = oya_prod.copy()

    for ko_prod in ko_products:
        if ko_prod["productId"] == oya_prod["productId"]:
            # ⭐ 子覆盖父
            merged = ko_prod
            break

    result_double.append(merged)

end = time.perf_counter()
print("二重ループ time:", end - start)

# =========================
# 3. dict merge（推荐）
# =========================
start = time.perf_counter()

# 建索引
ko_dict = {}
for ko_prod in ko_products:
    ko_dict[ko_prod["productId"]] = ko_prod

result_dict = []

for oya_prod in oya_products:
    pid = oya_prod["productId"]

    if pid in ko_dict:
        result_dict.append(ko_dict[pid])  # 子覆盖
    else:
        result_dict.append(oya_prod)

end = time.perf_counter()
print("dict time:", end - start)

# =========================
# 4. 组装最终contract
# =========================
final_contract = {
    "contract": {
        "contractBasic": oya_json["contract"]["contractBasic"],
        "contractor": oya_json["contract"]["contractor"],
        "productList": result_dict   # 用dict结果
    }
}

# 输出
with open("merged.json", "w", encoding="utf-8") as f:
    json.dump(final_contract, f, indent=2, ensure_ascii=False)

print("merge完成")
print("product数量:", len(result_dict))
