def merge_rule(oya, ko):

    if oya["pol"] != ko["pol"]:
        return None

    result = {
        "pol": oya["pol"],
        "kihon": oya["kihon"],
        "info": {}
    }

    rules = {
        "test1": "oya",
        "test2": "ko"
    }

    for key, source in rules.items():

        if source == "oya":
            result["info"][key] = oya["info"][key]
        else:
            result["info"][key] = ko["info"][key]

    return result
