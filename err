from rule_engine import apply_rule


class MergeEngine:

    def __init__(self, rules):
        self.rules = rules

    def merge(self, parent, child, path=""):

        result = {}

        keys = set(parent.keys()) | set(child.keys())

        for key in keys:

            new_path = f"{path}.{key}" if path else key

            rule = self.rules.get(new_path)

            p = parent.get(key)
            c = child.get(key)

            if isinstance(p, dict) and isinstance(c, dict):

                result[key] = self.merge(p, c, new_path)

            elif rule:

                result[key] = apply_rule(p, c, rule)

            else:

                result[key] = p if p else c

        return result
