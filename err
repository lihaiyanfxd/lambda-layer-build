from aws_lambda_powertools.event_handler.api_gateway import Router
from aws_lambda_powertools.utilities.validation import validator

router = Router()

schema = {
    "type": "object",
    "properties": {
        "id": {"type": "integer"},
        "age": {"type": "integer"}
    },
    "required": ["id"]
}

@router.post("/ping3")
@validator(inbound_schema=schema)
def ping3():
    body = router.current_event.json_body

    return {
        "id": body["id"],
        "age": body.get("age")
    }
