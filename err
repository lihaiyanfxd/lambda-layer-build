import json
import time
import copy

# =========================
# データ読み込み
# =========================
def loadJsonRules():

    with open("jsonData/oya2.json", "r", encoding="utf-8") as f:
        oya_data = json.load(f)

    with open("jsonData/ko2.json", "r", encoding="utf-8") as f:
        ko_data = json.load(f)

    with open("config/merge_rules2.json", "r", encoding="utf-8") as f:
        rules = json.load(f)

    start = time.perf_counter()

    for _ in range(100000):
        result = merge_v3(oya_data, ko_data, rules)

    end = time.perf_counter()
    print("merge time:", end - start)

    return result


# =========================
# ユーティリティ関数（値取得）
# =========================
def get(data, path):
    for p in path.split("."):
        data = data[p]
    return data


# =========================
# ユーティリティ関数（値設定）
# =========================
def set(data, path, value):
    keys = path.split(".")
    for k in keys[:-1]:
        data = data.setdefault(k, {})
    data[keys[-1]] = value


# =========================
# productList のマージ（二重ループ）
# =========================
def merge_product_list(oya, ko):

    oya_products = oya["contract"]["productList"]
    ko_products = ko["contract"].get("productList", [])

    merged_products = []

    for op in oya_products:
        merged = copy.deepcopy(op)

        for kp in ko_products:
            if op["productId"] == kp["productId"]:

                # 金額項目は子データ（ko）優先
                if "coverage" in kp:
                    merged["coverage"]["amount"] = kp["coverage"]["amount"]

                if "premium" in kp:
                    merged["premium"]["monthly"] = kp["premium"]["monthly"]

                break

        merged_products.append(merged)

    return merged_products


# =========================
# メインマージ処理
# =========================
def merge_v3(oya, ko, rules):

    result = {}

    for rule in rules:

        path = rule["path"]
        rule_type = rule["rule"]

        # ------------------------
        # 通常項目のマージ
        # ------------------------
        if rule_type == "parent":
            value = get(oya, path)
            set(result, path, value)

        elif rule_type == "child":
            try:
                value = get(ko, path)
            except:
                value = get(oya, path)
            set(result, path, value)

        # ------------------------
        # カスタム処理（productList）
        # ------------------------
        elif rule_type == "custom":
            value = merge_product_list(oya, ko)
            set(result, path, value)

    return result
