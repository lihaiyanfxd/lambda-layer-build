def merge_manual(oya, ko):

    result = oya.copy()

    # address
    if "contractBasic" in ko["contract"]:
        if "contractor" in ko["contract"]["contractBasic"]:
            addr_child = ko["contract"]["contractBasic"]["contractor"]["address"]
            result["contract"]["contractBasic"]["contractor"]["address"].update(addr_child)

    # product
    for ko_product in ko["contract"]["productList"]:
        for oya_product in result["contract"]["productList"]:
            if ko_product["productId"] == oya_product["productId"]:
                oya_product["coverage"].update(ko_product["coverage"])

    # history append
    result["contract"]["history"].extend(ko["contract"]["history"])

    return result
