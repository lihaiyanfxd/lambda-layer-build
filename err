def merge_double_loop(oya_json, ko_json):
    oya_products = oya_json["contract"]["productList"]
    ko_products = ko_json["contract"]["productList"]

    result = []

    for oya_prod in oya_products:
        merged_prod = oya_prod.copy()

        for ko_prod in ko_products:
            if ko_prod["productId"] == oya_prod["productId"]:

                # ===== product层覆盖 =====
                merged_prod = ko_prod.copy()

                # ===== benefit层（二重循环）=====
                merged_benefits = []

                for oya_b in oya_prod.get("benefitList", []):
                    found = False

                    for ko_b in ko_prod.get("benefitList", []):
                        if ko_b["benefitId"] == oya_b["benefitId"]:
                            merged_benefits.append(ko_b)
                            found = True
                            break

                    if not found:
                        merged_benefits.append(oya_b)

                # 补ko新增
                for ko_b in ko_prod.get("benefitList", []):
                    exists = False
                    for oya_b in oya_prod.get("benefitList", []):
                        if ko_b["benefitId"] == oya_b["benefitId"]:
                            exists = True
                            break
                    if not exists:
                        merged_benefits.append(ko_b)

                merged_prod["benefitList"] = merged_benefits
                break

        result.append(merged_prod)

    return {
        "contract": {
            "contractBasic": oya_json["contract"]["contractBasic"],
            "contractor": oya_json["contract"]["contractor"],
            "productList": result
        }
    }
def merge_dict(oya_json, ko_json):
    oya_products = oya_json["contract"]["productList"]
    ko_products = ko_json["contract"]["productList"]

    # ===== product索引 =====
    ko_product_dict = {p["productId"]: p for p in ko_products}

    result = []

    for oya_prod in oya_products:
        pid = oya_prod["productId"]

        # 没有子
        if pid not in ko_product_dict:
            result.append(oya_prod)
            continue

        ko_prod = ko_product_dict[pid]

        # ===== product merge =====
        merged_prod = {
            "productId": pid,
            "productName": ko_prod.get("productName", oya_prod["productName"]),
            "coverage": ko_prod.get("coverage", oya_prod["coverage"]),
            "premium": ko_prod.get("premium", oya_prod["premium"]),
        }

        # ===== benefit dict =====
        oya_benefits = oya_prod.get("benefitList", [])
        ko_benefits = ko_prod.get("benefitList", [])

        ko_benefit_dict = {b["benefitId"]: b for b in ko_benefits}

        merged_benefits = []

        # 先走oya（保证顺序）
        for oya_b in oya_benefits:
            bid = oya_b["benefitId"]

            if bid in ko_benefit_dict:
                merged_benefits.append(ko_benefit_dict[bid])
            else:
                merged_benefits.append(oya_b)

        # 补ko新增
        oya_ids = {b["benefitId"] for b in oya_benefits}

        for ko_b in ko_benefits:
            if ko_b["benefitId"] not in oya_ids:
                merged_benefits.append(ko_b)

        merged_prod["benefitList"] = merged_benefits

        result.append(merged_prod)

    return {
        "contract": {
            "contractBasic": oya_json["contract"]["contractBasic"],
            "contractor": oya_json["contract"]["contractor"],
            "productList": result
        }
    }
