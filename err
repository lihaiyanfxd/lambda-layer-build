def merge_dict(oya_items, ko_items):

    ko_map = {item["pol"]: item for item in ko_items}

    result = []

    for oya in oya_items:

        pol = oya["pol"]

        if pol in ko_map:

            ko = ko_map[pol]

            merged = {
                "pol": pol,
                "Kihondata": oya["Kihondata"],
                "info": {
                    "test1": oya["info"]["test1"],
                    "test2": ko["info"]["test2"]
                }
            }

            result.append(merged)

    return result
