def merge_double(oya_json, ko_json):
    print("merge_double()")

    oya_contract = oya_json["contract"]
    ko_contract = ko_json["contract"]

    oya_products = oya_contract["productList"]
    ko_products = ko_contract["productList"]

    result_products = []

    # =========================
    # 1. product + benefit merge（原逻辑）
    # =========================
    for oya_prod in oya_products:
        merged = oya_prod.copy()

        for ko_prod in ko_products:
            if ko_prod["productId"] == oya_prod["productId"]:

                merged = ko_prod.copy()

                # ===== benefit 二重循环 =====
                merged_benefits = []

                for oya_b in oya_prod["benefitList"]:
                    found = False

                    for ko_b in ko_prod["benefitList"]:
                        if ko_b["benefitId"] == oya_b["benefitId"]:
                            merged_benefits.append(ko_b)
                            found = True
                            break

                    if not found:
                        merged_benefits.append(oya_b)

                merged["benefitList"] = merged_benefits
                break

        result_products.append(merged)

    # =========================
    # 2. contract 层 merge（重点🔥）
    # =========================

    # contractBasic（保留）
    contract_basic = ko_contract.get("contractBasic", oya_contract.get("contractBasic"))

    # contractor.address → ko优先
    oya_contractor = oya_contract.get("contractor", {})
    ko_contractor = ko_contract.get("contractor", {})

    merged_contractor = {}

    if "address" in ko_contractor:
        # ✔ 使用 ko 的 address（Osaka）
        merged_contractor["address"] = ko_contractor["address"]
    else:
        merged_contractor["address"] = oya_contractor.get("address")

    # =========================
    # 3. 最终结果
    # =========================
    result = {
        "contract": {
            "contractBasic": contract_basic,
            "contractor": merged_contractor,
            "productList": result_products
        }
    }

    return result
