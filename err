def merge_dict_index(oya, ko):

    result = oya.copy()

    ko_map = {
        p["productId"]: p
        for p in ko["contract"]["productList"]
    }

    for p in result["contract"]["productList"]:
        pid = p["productId"]

        if pid in ko_map:
            p["coverage"].update(
                ko_map[pid]["coverage"]
            )

    result["contract"]["history"].extend(
        ko["contract"]["history"]
    )

    return result
