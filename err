import json


def get(data, path):
    for p in path.split("."):
        data = data[p]
    return data


def set(data, path, value):
    keys = path.split(".")
    for k in keys[:-1]:
        data = data.setdefault(k, {})
    data[keys[-1]] = value


with open("oya.json") as f:
    oya = json.load(f)

with open("ko.json") as f:
    ko = json.load(f)

with open("merge_rules.json") as f:
    rules = json.load(f)

result = {}

for rule in rules:

    path = rule["path"]

    if rule["rule"] == "parent":
        value = get(oya, path)
    else:
        value = get(ko, path)

    set(result, path, value)

print(json.dumps(result, indent=2, ensure_ascii=False))
