def recursive_merge(parent, child):

    for key, value in child.items():

        if key in parent and isinstance(parent[key], dict) and isinstance(value, dict):
            recursive_merge(parent[key], value)

        elif key in parent and isinstance(parent[key], list) and isinstance(value, list):
            parent[key].extend(value)

        else:
            parent[key] = value

    return parent
