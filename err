# user_router.py
from aws_lambda_powertools.event_handler.api_gateway import Router
from aws_lambda_powertools.utilities.validation import validator

router = Router()

# JSON Schema
schema = {
    "type": "object",
    "properties": {
        "id": {"type": "integer"},
        "age": {"type": "integer"}
    },
    "required": ["id"]
}

@router.post("/ping3")
@validator(inbound_schema=schema, envelope=None)  # envelope=None 表示直接验证 body
def ping3(body: dict):
    return {"id": body["id"], "age": body.get("age")}

@router.get("/user")
def user():
    return {"message": "user!"}

# lambda_function.py
from aws_lambda_powertools.event_handler.api_gateway import APIGatewayRestResolver
from user_router import router  # 引入路由

app = APIGatewayRestResolver()
app.include_router(router)  # 注册路由

def lambda_handler(event, context):
    return app.resolve(event, context)
