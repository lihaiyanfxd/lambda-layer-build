import copy

def merge_nested_loop(oya_json, ko_json):

    oya = oya_json["contract"]
    ko = ko_json["contract"]

    result = {}

    # ② 親契約基本情報コピー
    result["contractBasic"] = copy.deepcopy(oya["contractBasic"])

    child_contractor = ko.get("contractBasic", {}).get("contractor", {})

    if "contact" in child_contractor:
        result["contractBasic"]["contractor"]["contact"] = child_contractor["contact"]

    if "address" in child_contractor:
        parent_addr = result["contractBasic"]["contractor"]["address"]
        child_addr = child_contractor["address"]

        for k, v in child_addr.items():
            parent_addr[k] = v

    # 商品
    result["productList"] = copy.deepcopy(oya["productList"])

    for p in result["productList"]:

        for c in ko.get("productList", []):

            if p["productId"] == c["productId"]:

                if "coverage" in c:
                    p["coverage"] = c["coverage"]

                if "premium" in c:
                    p["premium"] = c["premium"]

                for pb in p.get("benefitList", []):

                    for cb in c.get("benefitList", []):

                        if pb["benefitId"] == cb["benefitId"]:
                            pb.update(cb)

    return {"contract": result}
