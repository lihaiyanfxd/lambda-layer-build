[tool.ruff]
select = ["E", "F", "I"]

# 可选：避免太严格（先不加 preview）
ignore = []

# 行宽（可选）
line-length = 88

{
  "ruff.enable": true,

  // 使用 Ruff 做 lint
  "python.linting.enabled": false,

  // ❗关闭自动格式化（否则E201/E202会被自动修掉）
  "editor.formatOnSave": false,

  // 可选：让 Ruff 用 preview（如果你开了）
  "ruff.lint.args": ["--preview"],

  // 可选：降低红色污染（推荐）
  "ruff.severity": {
    "E": "warning",
    "F": "error",
    "I": "information"
  }
}
