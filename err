def merge_double(oya_json, ko_json):
    print("merge_double()")
    oya_contract = oya_json["contract"]
    ko_contract = ko_json["contract"]

    # ===== contractor merge =====
    merged_contractor = copy.deepcopy(oya_contract.get("contractor", {}))
    ko_contractor = ko_contract.get("contractor", {})

    for key, value in ko_contractor.items():
        if isinstance(value, dict) and key in merged_contractor:
            merged_contractor[key].update(value)  # dict 合并
        else:
            merged_contractor[key] = value

    # ===== product + benefit 二重ループ =====
    oya_products = oya_contract.get("productList", [])
    ko_products = ko_contract.get("productList", [])

    result_products = []

    for oya_prod in oya_products:
        merged_prod = copy.deepcopy(oya_prod)
        for ko_prod in ko_products:
            if ko_prod["productId"] == oya_prod["productId"]:
                merged_prod = copy.deepcopy(ko_prod)

                # benefit merge 二重ループ
                merged_benefits = []
                for oya_b in oya_prod["benefitList"]:
                    found = False
                    for ko_b in ko_prod["benefitList"]:
                        if ko_b["benefitId"] == oya_b["benefitId"]:
                            merged_benefits.append(copy.deepcopy(ko_b))
                            found = True
                            break
                    if not found:
                        merged_benefits.append(copy.deepcopy(oya_b))

                merged_prod["benefitList"] = merged_benefits
                break

        result_products.append(merged_prod)

    # ===== contractBasic =====
    contract_basic = ko_contract.get("contractBasic", oya_contract.get("contractBasic"))

    return {
        "contract": {
            "contractBasic": contract_basic,
            "contractor": merged_contractor,
            "productList": result_products
        }
    }
