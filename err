import json
import time

# 模拟 1000 条 JSON
data1 = [{"id": i, "value": f"A{i}"} for i in range(1000)]
data2 = [{"id": i, "value": f"B{i}"} for i in range(1000)]

start = time.time()

# 示例：简单 diff
diff = []
for a, b in zip(data1, data2):
    if a != b:
        diff.append({"id": a["id"], "before": a, "after": b})

end = time.time()

print("diff count:", len(diff))
print("time:", end - start)
