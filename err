import json

with open("oya.json") as f:
    oya = json.load(f)

with open("ko.json") as f:
    ko = json.load(f)

result = {"contract": {}}

# 契約基本情報 親優先
result["contract"]["contractBasic"] = oya["contract"]["contractBasic"]

# 契約者情報 親優先
result["contract"]["contractor"] = oya["contract"]["contractor"]

# 連絡先 子優先
if "contractor" in ko["contract"]:
    result["contract"]["contractor"]["contact"].update(
        ko["contract"]["contractor"]["contact"]
    )

# 住所 子優先
result["contract"]["contractor"]["address"].update(
    ko["contract"]["contractor"]["address"]
)

# 商品 merge
parent_products = oya["contract"]["productList"]
child_products = ko["contract"]["productList"]

merged_products = []

for p in parent_products:
    for c in child_products:
        if p["productId"] == c["productId"]:

            p["coverage"].update(c["coverage"])
            p["premium"].update(c["premium"])

    merged_products.append(p)

result["contract"]["productList"] = merged_products

print(json.dumps(result, indent=2, ensure_ascii=False))
