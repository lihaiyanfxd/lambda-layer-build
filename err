{
  "contract": {
    "contractBasic": "parent",
    "contractor": {
      "name": "parent",
      "contact": "child",
      "address": "child"
    },
    "productList": {
      "key": "productId",
      "merge": {
        "productName": "parent",
        "coverage": "child",
        "premium": "child",
        "benefitList": {
          "key": "benefitId",
          "merge": {
            "benefitName": "parent",
            "benefitAmount": "child"
          }
        }
      }
    }
  }
}

def merge_v1(parent, child):
    result = parent.copy()

    for p in result["contract"]["productList"]:
        for c in child["contract"]["productList"]:
            if p["productId"] == c["productId"]:
                p["coverage"] = c["coverage"]
                p["premium"] = c["premium"]

                for pb in p["benefitList"]:
                    for cb in c["benefitList"]:
                        if pb["benefitId"] == cb["benefitId"]:
                            pb["benefitAmount"] = cb["benefitAmount"]

    return result

def merge_v3(parent, child):
    result = parent.copy()

    child_products = {
        c["productId"]: c for c in child["contract"]["productList"]
    }

    for p in result["contract"]["productList"]:
        pid = p["productId"]

        if pid in child_products:
            c = child_products[pid]

            p["coverage"] = c["coverage"]
            p["premium"] = c["premium"]

            child_benefits = {
                b["benefitId"]: b for b in c["benefitList"]
            }

            for pb in p["benefitList"]:
                bid = pb["benefitId"]
                if bid in child_benefits:
                    pb["benefitAmount"] = child_benefits[bid]["benefitAmount"]

    return result
