{
  "contract.contractBasic": "parent",
  "contract.contractor": "parent",
  "contract.contractor.contact": "child",
  "contract.contractor.address": "child"
}

import json

def get_path(data, path):
    keys = path.split(".")
    for k in keys:
        data = data[k]
    return data


def set_path(data, path, value):
    keys = path.split(".")
    for k in keys[:-1]:
        data = data.setdefault(k, {})
    data[keys[-1]] = value


with open("oya.json") as f:
    oya = json.load(f)

with open("ko.json") as f:
    ko = json.load(f)

with open("path_rules.json") as f:
    rules = json.load(f)

result = {}

for path, rule in rules.items():

    if rule == "parent":
        value = get_path(oya, path)

    else:
        value = get_path(ko, path)

    set_path(result, path, value)

print(json.dumps(result, indent=2, ensure_ascii=False))
